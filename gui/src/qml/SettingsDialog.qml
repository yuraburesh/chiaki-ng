                    contentHeight: keysGrid.height + anyplayEditor.implicitHeight + 60
                    flickableDirection: Flickable.AutoFlickIfNeeded
                    function ensureItemVisible(item) {
                        if (!item)
                            return;
                        const top = item.mapToItem(keysGrid, 0, 0).y;
                        const bottom = top + item.height;
                        if (top < contentY)
                            contentY = top;
                        else if (bottom > contentY + height)
                            contentY = bottom - height;
                    }
                    function focusItem(item) {
                        if (!item)
                            return;
                        item.forceActiveFocus(Qt.TabFocusReason);
                        ensureItemVisible(item);
                    }
                    // Keyboard / gamepad navigation for the mouse mode radio buttons
                    function mouseRadioKey(event, radio) {
                        switch (event.key) {
                        case Qt.Key_Left:
                            focusItem(radio.nextItemInFocusChain(false));
                            event.accepted = true;
                            break;
                        case Qt.Key_Right:
                            focusItem(radio.nextItemInFocusChain());
                            event.accepted = true;
                            break;
                        case Qt.Key_Up:
                            focusItem(mouseRadioDisabled.nextItemInFocusChain(false));
                            event.accepted = true;
                            break;
                        case Qt.Key_Down:
                            focusItem(mouseSliderHorizontal.visible
                                ? mouseSliderHorizontal
                                : mouseRadioRightStick.nextItemInFocusChain());
                            event.accepted = true;
                            break;
                        case Qt.Key_Return:
                        case Qt.Key_Enter:
                            radio.click();
                            event.accepted = true;
                            break;
                        }
                    }
