<RCC>
  <qresource prefix="/anyplay">
    <file>anyplay-controls.json</file>
    <file>anyplay-controls-gta6.json</file>
    <file>anyplay-controls-universal.json</file>
  </qresource>
  <qresource prefix="/icons">
    <file>settings-20px.svg</file>
    <file alias="ap-bolt.svg">anyplay-icons/bolt.svg</file>
    <file alias="ap-calendar.svg">anyplay-icons/calendar.svg</file>
    <file alias="ap-chart.svg">anyplay-icons/chart.svg</file>
    <file alias="ap-chat.svg">anyplay-icons/chat.svg</file>
    <file alias="ap-check.svg">anyplay-icons/check.svg</file>
    <file alias="ap-clock.svg">anyplay-icons/clock.svg</file>
    <file alias="ap-close.svg">anyplay-icons/close.svg</file>
    <file alias="ap-compass.svg">anyplay-icons/compass.svg</file>
    <file alias="ap-console.svg">anyplay-icons/console.svg</file>
    <file alias="ap-exit.svg">anyplay-icons/exit.svg</file>
    <file alias="ap-gamepad.svg">anyplay-icons/gamepad.svg</file>
    <file alias="ap-help.svg">anyplay-icons/help.svg</file>
    <file alias="ap-home.svg">anyplay-icons/home.svg</file>
    <file alias="ap-keyboard.svg">anyplay-icons/keyboard.svg</file>
    <file alias="ap-play.svg">anyplay-icons/play.svg</file>
    <file alias="ap-quality.svg">anyplay-icons/quality.svg</file>
    <file alias="ap-touch.svg">anyplay-icons/touch.svg</file>
    <file alias="ap-user.svg">anyplay-icons/user.svg</file>
    <file alias="ap-volume.svg">anyplay-icons/volume.svg</file>
    <file alias="ap-warning.svg">anyplay-icons/warning.svg</file>
    <file alias="ap-wrench.svg">anyplay-icons/wrench.svg</file>
    <file>add-24px.svg</file>
    <file>discover-24px.svg</file>
    <file>discover-off-24px.svg</file>
    <file>chiaking.svg</file>
    <file>anyplay-icon.png</file>
    <file>anyplay-logo.png</file>
    <file>chiaking-logo.svg</file>
    <file>chiaking-logo-white.svg</file>
    <file>chiaki.svg</file>
    <file>chiaki_macos.svg</file>
    <file>chiaking_macos.svg</file>
    <file>console-ps4.svg</file>
    <file>console-ps5.svg</file>
    <file>buttons-ps.svg</file>
    <file>buttons-deck.svg</file>
    <file>l1.svg</file>
    <file>r1.svg</file>
    <file>l3.svg</file>
    <file>r3.svg</file>
    <file>options.svg</file>
    <file>steam_hero.png</file>
    <file>steam_icon.png</file>
    <file>steam_landscape.png</file>
    <file>steam_logo.png</file>
    <file>steam_portrait.png</file>
  </qresource>
  <qresource prefix="/shaders">
    <file alias="FSR.glsl">shaders/FSR.glsl</file>
    <file alias="FSRCNNX_x2_8-0-4-1.glsl">shaders/FSRCNNX_x2_8-0-4-1.glsl</file>
    <file alias="FSRCNNX_x2_16-0-4-1.glsl">shaders/FSRCNNX_x2_16-0-4-1.glsl</file>
  </qresource>
</RCC>
